{
    "name": "capell-app/referer",
    "description": "Privacy-preserving aggregate referral reporting for Capell sites.",
    "keywords": ["capell", "referer", "referrer", "analytics", "filamentphp"],
    "homepage": "https://github.com/capell-app/referer",
    "license": "proprietary",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0",
        "capell-app/core": "^1.0",
        "capell-app/frontend": "^1.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1",
        "spatie/laravel-referer": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Capell\\Referer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\Referer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Referer\\Providers\\RefererServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/referer",
        "docs": "https://docs.capell.app/packages/referer"
    }
}
