{
    "manifest-version": 3,
    "name": "capell-app/referer",
    "slug": "referer",
    "displayName": "Referers",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Counts arrivals from search and social websites by name, with no visitor records, and reports them in the admin and on a dashboard card.",
    "product": {
        "group": "Capell Marketing & Growth",
        "tier": "free",
        "bundle": "marketing-growth"
    },
    "namespace": "Capell\\Referer",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\Referer\\Providers\\RefererServiceProvider",
            "Capell\\Referer\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": ["Capell\\Referer\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Referer\\Providers\\RefererServiceProvider"],
        "admin": ["Capell\\Referer\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\Referer\\Manifest\\RefererAdminPageContribution",
            "pageClass": "Capell\\Referer\\Filament\\Pages\\RefererPage",
            "labelKey": "capell-referer::package.navigation",
            "permission": "View:RefererPage"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Referer\\Manifest\\RefererDashboardFilamentWidgetsContribution",
            "widgetClasses": [
                "Capell\\Referer\\Filament\\Widgets\\TopRefererSourcesFilamentWidget"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\Referer\\Manifest\\RefererModelsContribution",
            "modelClasses": [
                "Capell\\Referer\\Models\\RefererDailyCount",
                "Capell\\Referer\\Models\\RefererSourceTotal"
            ]
        },
        {
            "type": "permission",
            "class": "Capell\\Referer\\Manifest\\RefererPermissionsContribution",
            "permissions": ["View:RefererPage"]
        },
        {
            "type": "migration",
            "class": "Capell\\Referer\\Manifest\\RefererMigrationsContribution",
            "tables": [
                "referer_daily_counts",
                "referer_source_totals",
                "referer_retention_state"
            ],
            "migrationFiles": ["2026_09_14_000001_create_referer_counts_tables"]
        },
        {
            "type": "console-command",
            "class": "Capell\\Referer\\Manifest\\RefererConsoleCommandsContribution",
            "commands": [
                "capell:referer:demo",
                "capell:referer:prune",
                "capell:referer:screenshot-fixture"
            ],
            "commandClasses": [
                "Capell\\Referer\\Console\\Commands\\SeedRefererDemoCommand",
                "Capell\\Referer\\Console\\Commands\\PruneRefererCountsCommand",
                "Capell\\Referer\\Console\\Commands\\SeedRefererScreenshotFixtureCommand"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Referer\\Manifest\\RefererRetentionScheduleContribution",
            "command": "capell:referer:prune",
            "name": "capell-referer-retention",
            "frequency": "daily"
        },
        {
            "type": "health-check",
            "class": "Capell\\Referer\\Manifest\\RefererHealthContribution",
            "checkClass": "Capell\\Referer\\Health\\RefererHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "referer_daily_counts",
            "referer_source_totals",
            "referer_retention_state"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:referer:demo",
        "doctor": null,
        "prune": "capell:referer:prune",
        "maintenance": ["capell:referer:prune"]
    },
    "settings": [],
    "permissions": ["View:RefererPage"],
    "capabilities": [],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["View:RefererPage"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 5,
        "adminQueryBudget": 20,
        "cacheTags": ["referer"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "window"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "referer.package-health",
            "label": "Referer storage, frontend registration, and write health are discoverable by Diagnostics.",
            "class": "Capell\\Referer\\Health\\RefererHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Daily counts of which search and social websites send people to your own site, kept as totals only, with an admin report and dashboard card.",
        "description": "See where arrivals come from. Referers recognises eight search and social sites, groups every other outside site as Other external, and stores a count for each of your sites per day and label, plus running totals, with nothing about individual visitors. The Monitoring report offers preset and custom periods, and a dashboard card shows the leading sources. Access follows each person's site scope and permissions.",
        "problem": "I can't tell which other websites bring people to our pages.",
        "outcome": "An admin report and dashboard card show which websites sent people.",
        "faq": [
            {
                "question": "Does it keep a record of individual visitors?",
                "answer": "No. It stores only counts for each site, day and label, plus a running total for each site and label. No IP address, cookie, page address or individual visit is kept."
            },
            {
                "question": "Which websites does the report name?",
                "answer": "Google, Facebook and six other well-known sites. Every other website that sends people to yours is grouped as Other external, and a developer must add any other site you want named."
            },
            {
                "question": "Why might the numbers differ from my real visitors?",
                "answer": "A reload can count again, so one person can be counted more than once. Crawlers, link-preview fetchers and prefetch requests are skipped, and so are pages served from a saved copy such as one held by HTML Cache or a CDN."
            },
            {
                "question": "How long are the counts kept?",
                "answer": "Daily counts are deleted after 400 days and all-time totals are kept. The clean-up needs background jobs, which your host or developer must have running."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/referer-admin-report.png",
                "alt": "Referrers report for a demo site over 30 days listing Google, Bing, LinkedIn and Other external with counts and shares.",
                "caption": "See which sites sent people to yours, how many arrivals each sent and its share of the total."
            }
        ],
        "categories": ["admin", "growth"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
